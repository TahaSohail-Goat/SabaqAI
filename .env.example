# Copy to .env.local and fill in. Never commit .env.local.
# See docs/setup.md for where each key comes from.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set false after a database-only restore. The options route then checks local Storage and
# shows PDFs that were restored, with OCR text for chapters whose PDF bytes are still missing.
SOURCE_PDF_BYTES_AVAILABLE=true

# --- Direct database access (dev/testing only — scripts/dev-db-sql.mjs) ---
# From Project Settings → Database → Connection string → Session pooler.
# The DB password is the one set when the project was created; it is NOT an API key.
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Optional: path to the Supabase CA bundle if your system store doesn't chain it
# (Project Settings → Database → SSL). TLS verification is never disabled.
SUPABASE_DB_CA_CERT=

# --- Embeddings: Jina AI (configured) or DashScope — one OpenAI-compatible client serves both ---
# Jina (current provider): key from https://jina.ai, base URL https://api.jina.ai/v1,
#   model jina-embeddings-v3 — native 1024-dim.
# DashScope/Qwen (drop-in alternative): key from the Model Studio console, leave
#   EMBEDDING_BASE_URL blank, EMBEDDING_MODEL=text-embedding-v3 — also 1024-dim.
# Both match vector(1024) in the migration. If you change the model, EMBEDDING_DIM and the
# migration must both change too, and you must re-embed everything. Mismatched dimensions is
# the #1 silent bug — run `node scripts/verify-embeddings.mjs` before ingesting.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=1024

# --- Generation: Gemini ---
GEMINI_API_KEY=
# gemini-2.5-flash's free tier is capped at 20 requests/day — exhausts almost immediately during
# development. The "-lite" flash variants return in <1-2.5s; non-lite flash models on this
# account measured 30s+ per reply (extra "thinking" latency even at the lowest thinking level) —
# use a "-lite" model unless you've specifically confirmed a heavier one is fast enough for you.
CHAT_MODEL=gemini-3.5-flash-lite

# --- Groq: Chat, voice input and automatic Ask/Quiz provider fallback (optional) ---
# Ask uses the existing Chat Groq model on temporary Gemini service/connection failures or 429.
# The original request deadline, call cap and full grounding/adequacy review still apply.
GROQ_API_KEY=
STT_MODEL=whisper-large-v3

# --- Quiz answer-key encryption ---
# Encrypts the quiz answer key so it can be handed to the browser without exposing the answers.
# Any long random string. REQUIRED before deploying: without it, each server instance generates
# its own ephemeral key and grading fails intermittently across instances.
#   Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUIZ_SECRET=

# --- Concept Lab signed temporary sessions ---
# Optional separate server-only key, at least 32 characters. Falls back to QUIZ_SECRET.
# Shared across instances; no random process-local fallback. See PHYSICS_LAB_DEMO.md.
LAB_STATE_SECRET=

# --- Retrieval ---
TOP_K=20
CONTEXT_MAX_CHUNKS=6

# --- Evolved Ask/Doubts (active by default; see docs/ask-evolution/IMPLEMENTATION.md) ---
ASK_QUERY_UNDERSTANDING_ENABLED=true
ASK_CONCEPT_EXPANSION_ENABLED=true
ASK_SUPPORT_REVIEW_ENABLED=true
ASK_REPAIR_ENABLED=false
ASK_MAX_INPUT_CHARS=1600
ASK_MAX_SEED_CHUNKS=6
ASK_MAX_CONTEXT_CHUNKS=10
ASK_NEIGHBOR_WINDOW=1
ASK_MAX_CONTEXT_TOKENS=7000
ASK_MAX_OUTPUT_TOKENS=4000
ASK_TOTAL_TIMEOUT_MS=110000
# Ceiling, not a target: four routine stages, at most one repair + fresh review.
# A lower explicit cap is honored and may leave no room for a verified repair.
ASK_MAX_LLM_CALLS=6
ASK_CLARIFICATION_TTL_SECONDS=600
# Set a shared random secret (at least 32 characters) for multi-instance clarification resumption.
# If blank, a process-local random key is used; restarts require a fresh question.
ASK_CLARIFICATION_SECRET=

# --- Confidence gate ---
# Starting guesses ONLY. Calibrate against real ingested content on Day 6
# before you quote any of these to a judge. See docs/evaluation.md.
PASS_TOP1=0.62
BORDERLINE_TOP1=0.52
SUPPORT_SCORE=0.50

# --- Email (Nodemailer / Gmail SMTP) ---
# Required for email OTP verification at signup.
# Use a Gmail App Password: Google Account → Security → 2-Step Verification → App Passwords.
SMTP_EMAIL=yourgmail@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
