# Copy to .env.local and fill in. NEVER commit .env.local.

# Supabase (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SECRET. Server only. Never used in browser code.

# AI provider (one provider for both embeddings and chat)
AI_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024                  # must match vector(N) in the migration
CHAT_MODEL=

# Guardrail thresholds (calibrate on Day 6 — these are starting guesses)
PASS_TOP1=0.62
BORDERLINE_TOP1=0.52
SUPPORT_SCORE=0.50

# Retrieval
TOP_K=20
CONTEXT_MAX_CHUNKS=6
