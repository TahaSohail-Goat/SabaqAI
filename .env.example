# Copy to .env.local and fill in. Never commit .env.local.
# See docs/setup.md for where each key comes from.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Direct database access (dev/testing only — scripts/dev-db-sql.mjs) ---
# From Project Settings → Database → Connection string → Session pooler.
# The DB password is the one set when the project was created; it is NOT an API key.
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Optional: path to the Supabase CA bundle if your system store doesn't chain it
# (Project Settings → Database → SSL). TLS verification is never disabled.
SUPABASE_DB_CA_CERT=

# --- Embeddings: Jina AI by default; any OpenAI-compatible /embeddings endpoint works ---
# jina-embeddings-v3 is 1024-dim, which matches vector(1024) in the migration.
# Get a key: https://jina.ai/api-dashboard (1M free tokens, no card required).
# For DashScope/Qwen text-embedding-v3 instead (also 1024-dim), set:
#   EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_MODEL=text-embedding-v3
# ONE model must embed both chunks and questions forever. Changing EMBEDDING_MODEL or
# EMBEDDING_DIM means changing the migration's vector(N) AND re-embedding everything.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=1024

# --- Generation: Gemini ---
GEMINI_API_KEY=
CHAT_MODEL=gemini-2.5-flash

# --- Voice input: Whisper via Groq (optional, Day 5) ---
GROQ_API_KEY=
STT_MODEL=whisper-large-v3

# --- Quiz answer-key encryption ---
# Encrypts the quiz answer key so it can be handed to the browser without exposing the answers.
# Any long random string. REQUIRED before deploying: without it, each server instance generates
# its own ephemeral key and grading fails intermittently across instances.
#   Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUIZ_SECRET=

# --- Retrieval ---
TOP_K=20
CONTEXT_MAX_CHUNKS=6

# --- Confidence gate ---
# Starting guesses ONLY. Calibrate against real ingested content on Day 6
# before you quote any of these to a judge. See docs/evaluation.md.
PASS_TOP1=0.62
BORDERLINE_TOP1=0.52
SUPPORT_SCORE=0.50
